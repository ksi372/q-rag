# =============================================
# Synergy RAG backend configuration
# =============================================

# ---------------------------------------------
# Data store
# ---------------------------------------------
# The original project (xgydxmkpiafamshojwmd) is gone -- its hostname no longer
# resolves. While SUPABASE_URL is blank the backend uses the local SQLite store
# at server/local_data/synergy.db, so the app runs standalone.
#
# New project is <your-project-ref>. To switch over:
#   1. Run supabase/setup.sql in the SQL editor. It uses vector(384) to match
#      the local embedding model -- migration 002's 768 is for Gemini only.
#   2. Uncomment SUPABASE_URL below.
#   3. Paste the service_role key into SUPABASE_SERVICE_KEY. This is required:
#      the backend writes on the user's behalf and RLS blocks the anon key
#      (auth.uid() is null for anon, so every policy evaluates false).
#      Find it at Settings -> API -> service_role, "secret".
#   4. Also switch the frontend on in .env.local, then restart both processes.
#
# SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------
# Embeddings: local | gemini
# ---------------------------------------------
# Yotta's gateway exposes no /embeddings route and the Gemini key has no
# credits, so embeddings run locally through ONNX. First run downloads ~130MB
# to the fastembed cache; after that it is offline and free.
EMBEDDING_PROVIDER=
LOCAL_EMBEDDING_MODEL=
LOCAL_EMBEDDING_DIM=

# ---------------------------------------------
# LLM: yotta | gemini | none
# ---------------------------------------------
# Yotta / Shakti Cloud, OpenAI-compatible. Used for query rewriting, semantic
# reranking, and answer generation. `none` degrades gracefully: retrieval falls
# back to pure cosine similarity and reports 0 auxiliary tokens.
LLM_PROVIDER=
YOTTA_BASE_URL=
YOTTA_GATEWAY_ID=
YOTTA_API_KEY=
YOTTA_MODEL=
# The gateway `id` header pins to one deployment, so it is only sent when
# YOTTA_MODEL equals this. Other models (e.g. openai/gpt-oss-120b) route by name.
YOTTA_GATEWAY_MODEL=
# DeepSeek defaults to thinking mode, which bills reasoning tokens against
# max_tokens and can starve short answers like a rerank score.
YOTTA_THINKING=
# Reranking issues one small call per candidate chunk; this bounds how many run
# at once. Sequential calls made a 20-chunk rerank take ~60s of pure latency.
LLM_MAX_CONCURRENCY=

# ---------------------------------------------
# Chunk selection
# ---------------------------------------------
# annealing = build the real QUBO (server/qubo.py) and minimize it with simulated
# annealing. greedy = the original heuristic, kept so the two can be benchmarked
# against each other (server/benchmark_qubo.py) rather than swapped on faith.
QUBO_SOLVER=

# Objective coefficients. See the QUBO section of README.md for what each does.
# QUBO_KAPPA is the cardinality anchor and is load-bearing for honest metrics:
# at 0 the optimizer discovers that selecting almost nothing minimizes tokens and
# maximizes avg_rf_score (a mean over one chunk), which looks like a huge win on
# the dashboard while the answer gets worse. Do not zero it to "improve" results.
QUBO_ALPHA=
QUBO_BETA=
QUBO_GAMMA=
QUBO_KAPPA=
QUBO_K_TARGET=
# Leave blank to calibrate the redundancy floor per query from the candidate
# pool's own similarity distribution. A fixed value is model-dependent and
# dangerous: with bge-small the minimum observed pair similarity was 0.552, so a
# 0.55 floor marked 100% of pairs redundant and collapsed selection to 2-3 chunks.
QUBO_REDUNDANCY_FLOOR=
QUBO_REDUNDANCY_QUANTILE=

# ---------------------------------------------
# Token counting
# ---------------------------------------------
# Every "tokens saved" figure in the comparison view comes from this tokenizer,
# so it is the answering model's real one rather than a chars/4 estimate.
TOKENIZER_REPO=

# ---------------------------------------------
# Optional: Gemini (unused while credits are depleted)
# ---------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# ---------------------------------------------
# Optional LLM stages (latency vs retrieval quality)
# ---------------------------------------------
# Measured on this gateway: ~3.5s per LLM call regardless of size, and calls do
# NOT parallelize (12 concurrent trivial calls took 17.8s, not ~7s). Latency
# therefore tracks the NUMBER of round-trips, not their size.
#
#   both on  -> ~47s per question   (query rewriting + LLM reranking + answer)
#   both off -> ~11s per question   (answer only)
#
# Settled by measurement across three configurations (8 queries, blind judge).
# Numbers are annealing quality / baseline quality / gap:
#
#   rewrite ON,  rerank ON   ->  7.50 / 8.38 / -0.88   ~47s
#   rewrite OFF, rerank ON   ->  9.38 / 9.00 / +0.38   ~40s   <-- this one
#   rewrite OFF, rerank OFF  ->  7.38 / 9.63 / -2.25   ~11s
#
# Two findings, neither of them what was expected:
#
#   1. Reranking is load-bearing. Removing it is what collapsed the comparison,
#      not the loss of rewriting.
#   2. Query rewriting was actively HURTING. Turning it off raised annealing
#      quality 7.50 -> 9.38 and is the only configuration where the QUBO beats
#      plain top-k outright. Paraphrases widen the candidate pool with loosely
#      related chunks, and that noise survives into the selection.
#
# So rewriting is off for quality, not for speed; the ~7s saved is incidental.
ENABLE_QUERY_REWRITING=
ENABLE_LLM_RERANKING=

# ---------------------------------------------
# Demo stage
# ---------------------------------------------
# Gates how much of the pipeline the running app surfaces. Nothing is deleted or
# permanently disabled -- see docs/demo-stages.md for exactly what each stage
# shows and the justification for the split.
#
#   review2  Working ingestion, retrieval, scoring and the greedy selector, with
#            a basic context-size comparison. The QUBO annealer and its solver
#            diagnostics stay off screen.
#   review3  Everything, including the real QUBO and annealing internals.
#   full     Alias for review3.
#
# The stage never alters a measured value. It only decides which parts of the
# work are on screen; whatever is displayed is real output from the code path
# named. Switch with one edit plus a backend restart.
DEMO_STAGE=
